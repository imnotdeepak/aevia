# Copy to .env and fill in. Never commit real values.
DATABASE_URL=
BETTER_AUTH_SECRET=
# The public address of the app (used for sign-in links and Stripe return links)
BETTER_AUTH_URL=http://localhost:3001

# Stripe (use test-mode keys while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a fixed $2/month Price id (price_...). Leave empty to define the price inline.
STRIPE_PRICE_ID=
